<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand (locked) -->
    <SolidColorBrush x:Key="BrandBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="BrandLightBrush" Color="#EEF2FF"/>

    <!-- Surface -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F3F4F6"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Text1Brush" Color="#111827"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#374151"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#6B7280"/>

    <!-- Gray ramp -->
    <SolidColorBrush x:Key="Gray50Brush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="#475569"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="#1E293B"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>

</ResourceDictionary>
