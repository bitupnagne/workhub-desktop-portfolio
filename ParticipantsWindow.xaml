<Window x:Class="Portfolio.OfficeSystem.ParticipantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="대화 참여자" Width="300" Height="460"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/App.ico"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <local:StatusColorConverter x:Key="StatusColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Direction="270"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="{StaticResource IconClose}" Click="Close_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Padding="0" FontSize="14"/>
                <TextBlock Text="대화 참여자" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="1" x:Name="lstMembers" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="MemberRow_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="16" Height="16" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <Border Width="9" Height="9" CornerRadius="4.5" DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                                        Background="{Binding ActualStatusClass, Converter={StaticResource StatusColorConverter}}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text1Brush}"/>
                                        <TextBlock Text="{Binding JobTitle}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
