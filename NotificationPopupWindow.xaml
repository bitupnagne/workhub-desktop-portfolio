<Window x:Class="Portfolio.OfficeSystem.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="메시지 알림"
        Width="300" Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}">
    <Border x:Name="popupCard"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BrandBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="10"
            Cursor="Hand"
            MouseLeftButtonUp="PopupCard_MouseLeftButtonUp"
            MouseEnter="PopupCard_MouseEnter"
            MouseLeave="PopupCard_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.22" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource BrandLightBrush}" VerticalAlignment="Top">
                <svg:SvgViewbox Source="/Icons/message-circle.svg" Width="15" Height="15"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                <TextBlock x:Name="txtTitle" Text="새 메시지" FontSize="12" FontWeight="Black" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtSender" Text="메시지" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandDarkBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtBody" Text="내용" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" Content="×" Width="22" Height="22" VerticalAlignment="Top" Click="Close_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" FontSize="13" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
