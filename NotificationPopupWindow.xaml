<Window x:Class="Portfolio.OfficeSystem.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="메시지 알림"
        Width="450" Height="108"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}">
    <Border x:Name="popupCard"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BrandBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="15"
            Cursor="Hand"
            MouseLeftButtonUp="PopupCard_MouseLeftButtonUp"
            MouseEnter="PopupCard_MouseEnter"
            MouseLeave="PopupCard_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.22" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="51"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="45" Height="45" CornerRadius="23" Background="{DynamicResource BrandLightBrush}" VerticalAlignment="Top">
                <svg:SvgViewbox Source="/Icons/message-circle.svg" Width="22" Height="22"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                <TextBlock x:Name="txtTitle" Text="새 메시지" FontSize="18" FontWeight="Black" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtSender" Text="메시지" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrandDarkBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtBody" Text="내용" FontSize="16" Foreground="{DynamicResource Text2Brush}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" Width="33" Height="33" VerticalAlignment="Top" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="닫기" Padding="0">
                <svg:SvgViewbox Source="/Icons/x.svg" Width="16" Height="16"/>
            </Button>
        </Grid>
    </Border>
</Window>
