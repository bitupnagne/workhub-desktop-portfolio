<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Portfolio.OfficeSystem</AssemblyName>
    <RootNamespace>Portfolio.OfficeSystem</RootNamespace>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <Version>1.0.28</Version>
    <AssemblyVersion>1.0.28.0</AssemblyVersion>
    <FileVersion>1.0.28.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);output\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="updater\**\*.cs" />
    <Page Remove="updater\**\*.xaml" />
    <None Remove="updater\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="App.ico" />
    <Resource Include="AppLogo.svg" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Icons\*.svg" />
    <Resource Include="Sounds\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

</Project>
