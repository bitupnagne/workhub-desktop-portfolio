<Window x:Class="Portfolio.OfficeSystem.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkHub Desktop 업데이트" Height="360" Width="520"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Malgun Gothic">
    <Border Background="White" BorderBrush="#4F46E5" BorderThickness="1.5">
        <Grid>
            <Button Content="—" Click="Minimize_Click" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Cursor="Hand" FontSize="16" ToolTip="최소화" Panel.ZIndex="10"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <Image x:Name="UpdaterLogo" Width="256" Height="64" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed"/>
                <TextBlock Text="WorkHub Desktop" FontSize="24" FontWeight="ExtraBold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="업데이트를 설치하고 있습니다" FontSize="17" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Text="" FontSize="12" FontWeight="Bold" Foreground="#4338CA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusText" Text="잠시만 기다려 주세요..." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                <Border Width="320" Height="6" Background="#F1F5F9" CornerRadius="3" ClipToBounds="True">
                    <Grid>
                        <Rectangle x:Name="DetermFill" Width="0" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="0.5"/>
                                    <GradientStop Color="#A5B4FC" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="AnimationBar" Width="120" HorizontalAlignment="Left" RadiusX="3" RadiusY="3">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="0.5"/>
                                    <GradientStop Color="#A5B4FC" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="BarTranslate" X="-120"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>
                <TextBlock x:Name="PercentText" Text="" FontSize="11" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
