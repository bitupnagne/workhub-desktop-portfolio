<Window x:Class="Portfolio.OfficeSystem.MemberPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        Title="대상 선택" Width="380" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/App.ico"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- 선택 가능한 행(직원/조직 공통) 스타일: IsSelected → 브랜드 강조 -->
        <Style x:Key="PickRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CheckDot" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.2" Direction="270"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 헤더 (드래그) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Padding="0" FontSize="14"/>
                <TextBlock x:Name="txtHeader" Text="대상 선택" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 탭 -->
            <Border Grid.Row="1" CornerRadius="11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Padding="3" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="tabEmpBg" Grid.Column="0" CornerRadius="9" Background="{DynamicResource BrandLightBrush}"/>
                    <Border x:Name="tabOrgBg" Grid.Column="1" CornerRadius="9" Background="Transparent"/>
                    <Button Grid.Column="0" Content="직원" Click="TabEmployees_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text1Brush}"/>
                    <Button Grid.Column="1" Content="조직" Click="TabOrgs_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="32" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Text1Brush}"/>
                </Grid>
            </Border>

            <!-- 선택 칩 -->
            <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" Padding="6" Margin="0,0,0,10" MinHeight="40">
                <Grid>
                    <TextBlock x:Name="txtChipEmpty" Text="아래에서 대상을 선택하세요" Foreground="{DynamicResource Text3Brush}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                    <ItemsControl x:Name="chipList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Background="{DynamicResource BrandLightBrush}" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" Padding="10,3,5,3" Margin="0,0,6,6" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource BrandDarkBrush}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource BrandDarkBrush}" FontSize="10" FontWeight="Bold" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="#22000000" Margin="5,0,0,0" Cursor="Hand" MouseLeftButtonUp="ChipRemove_Click">
                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 본문: 직원 / 조직 -->
            <Grid Grid.Row="3">
                <!-- 직원 탭 -->
                <Grid x:Name="panelEmployees">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtSearch" Grid.Row="0" Height="32" Margin="0,0,0,8" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="Search_TextChanged"
                             Background="{DynamicResource SurfaceAltBrush}"
                             Foreground="{DynamicResource Text1Brush}"
                             CaretBrush="{DynamicResource Text1Brush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Tag="이름/팀 검색"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="empList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PickRow}" Padding="9,7" MouseLeftButtonUp="EmpRow_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource CheckDot}" VerticalAlignment="Center">
                                                <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}"/>
                                                <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                <!-- 조직 탭 (멤버 미표시, 조직만 선택) -->
                <ScrollViewer x:Name="panelOrgs" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="orgList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PickRow}" Padding="0,7" MouseLeftButtonUp="OrgRow_Click">
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                        <!-- 3상태 체크: ✓(체크) / –(부분) / 빈 -->
                                        <Border Style="{StaticResource CheckDot}" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="–" Foreground="{DynamicResource BrandDarkBrush}" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsPartial, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 푸터 -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtSummary" Grid.Column="0" Text="0명 선택" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}"/>
                <Button Grid.Column="1" Content="취소" Click="Close_Click" Height="38" Padding="16,0" Margin="0,0,8,0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource Text2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                <Button x:Name="btnConfirm" Grid.Column="2" Content="확인" Click="Confirm_Click" Height="38" Padding="20,0" Background="{DynamicResource BrandBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
