<Window x:Class="Portfolio.OfficeSystem.WorkMemoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="자료전송" Width="380" Height="540"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/App.ico"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Direction="270"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 헤더 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="{StaticResource IconClose}" Click="Close_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Padding="0" FontSize="14"/>
                <Border DockPanel.Dock="Right" Cursor="Hand" Padding="6" Margin="0,0,4,0" Background="Transparent"
                        PreviewMouseLeftButtonDown="StarBorder_PreviewDown"
                        MouseLeftButtonUp="ToggleStar_Click" ToolTip="중요 표시">
                    <Path x:Name="starIcon" Data="{StaticResource IconGeoStar}" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                </Border>
                <TextBlock Text="자료전송" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
            </DockPanel>
            <!-- 보낸 일시 + 제목 ([1.0.78] 중요 뱃지 폐기, 즐겨찾기로 일원화) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="txtSentAt" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtTitle" FontSize="17" FontWeight="ExtraBold" TextWrapping="Wrap" Foreground="{DynamicResource Text1Brush}"/>
            </StackPanel>
            <!-- 발신자 + 수신자 -->
            <Border Grid.Row="2" Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="보낸 사람" FontSize="11" Foreground="{DynamicResource Text3Brush}" Width="64"/>
                        <TextBlock x:Name="txtSender" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrandDarkBrush}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="받는 사람" FontSize="11" Foreground="{DynamicResource Text3Brush}" Width="64" VerticalAlignment="Top"/>
                        <TextBlock x:Name="txtRecipients" FontSize="12" Foreground="{DynamicResource Text1Brush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </Border>
            <!-- 본문 + 첨부 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="txtBody" FontSize="13" LineHeight="20" Foreground="{DynamicResource Text1Brush}" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="lstAttachments" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="11" CornerRadius="10" MinWidth="220" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="Attachment_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandLightBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="↓" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginalFilename}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="220" Foreground="{DynamicResource Text1Brush}"/>
                                            <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
