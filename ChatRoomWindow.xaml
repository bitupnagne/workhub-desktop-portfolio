<Window x:Class="Portfolio.OfficeSystem.ChatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WorkHub Desktop - 메시지" Height="550" Width="380"
        MinHeight="470" MinWidth="340"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent"
        Icon="/App.ico"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="15" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <local:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <local:MessageForegroundConverter x:Key="MessageForegroundConverter"/>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <local:StatusColorConverter x:Key="StatusColorConverter"/>
        <local:SystemMessageVisibilityConverter x:Key="SystemMessageVisibilityConverter"/>
        <local:NormalMessageVisibilityConverter x:Key="NormalMessageVisibilityConverter"/>
        <local:ExpandIconConverter x:Key="ExpandIconConverter"/>
        <local:OrgNodeBorderConverter x:Key="OrgNodeBorderConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <sys:Double x:Key="MessageBodyFontSize">14</sys:Double>
        <sys:Double x:Key="MessageBodyLineHeight">21</sys:Double>
        
        <Style x:Key="ChatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InviteRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmoothSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Gray100Brush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource BrandBrush}" Height="6" BorderThickness="0" Opacity="0.75"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" Height="6" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <primitives:Thumb Width="16" Height="16">
                                        <primitives:Thumb.Template>
                                            <ControlTemplate TargetType="primitives:Thumb">
                                                <Border Background="{DynamicResource BrandBrush}" BorderBrush="White" BorderThickness="2" CornerRadius="8">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.22"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </primitives:Thumb.Template>
                                    </primitives:Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatInviteTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabFrame" Margin="2" Padding="0,8" CornerRadius="9" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabFrame" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabFrame" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WebTabItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="container" Background="Transparent" Margin="0,0,1,0">
                            <Border x:Name="border" Padding="0,14" BorderThickness="0,0,0,4" BorderBrush="Transparent"
                                    TextElement.Foreground="{DynamicResource Text3Brush}"
                                    TextElement.FontWeight="Bold"
                                    TextElement.FontSize="14">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="container" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource Text1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="{DynamicResource SurfaceBrush}"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel LastChildFill="False">
                    <local:RoomAvatarView x:Name="roomAvatarHeader" Width="38" Height="38" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button Content="{StaticResource IconClose}" Click="CloseButton_Click" DockPanel.Dock="Right" Width="34" Height="34" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Margin="8,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerLightBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="—" Click="Minimize_Click" DockPanel.Dock="Right" Width="34" Height="34" Background="Transparent" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Margin="8,0,0,0"/>

                    <Button x:Name="btnSearchToggle" Click="SearchToggle_Click" DockPanel.Dock="Right" Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource Text3Brush}" Cursor="Hand">
                        <svg:SvgViewbox Source="/Icons/search.svg" Width="16" Height="16"/>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="btnSettings" Click="Settings_Click" DockPanel.Dock="Right" Width="34" Height="34" Margin="8,0,0,0" Background="Transparent" Foreground="{DynamicResource Text3Brush}" Cursor="Hand">
                        <svg:SvgViewbox Source="/Icons/settings.svg" Width="16" Height="16"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="채팅방 이름 변경" Click="RenameRoom_Click"/>
                                <MenuItem x:Name="mnuTogglePin" Header="채팅방 상단 고정" Click="TogglePin_Click"/>
                                <MenuItem x:Name="mnuToggleMute" Header="채팅방 알림 끄기" Click="ToggleMute_Click"/>
                                <Separator/>
                                <MenuItem Click="ShowInvite_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Source="/Icons/users.svg" Width="14" Height="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="대화 상대 초대" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="mnuMessageFontSmall" Header="글자 작게" Click="MessageFontSmall_Click"/>
                                <MenuItem x:Name="mnuMessageFontMedium" Header="글자 중간" Click="MessageFontMedium_Click"/>
                                <MenuItem x:Name="mnuMessageFontLarge" Header="글자 크게" Click="MessageFontLarge_Click"/>
                                <Separator/>
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,3,4,3">
                                            <TextBlock Text="투명도" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                                            <Slider x:Name="sldOpacity" Width="120" VerticalAlignment="Center" Style="{StaticResource SmoothSliderStyle}" Minimum="20" Maximum="100" Value="100" TickFrequency="10" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged"/>
                                            <TextBlock x:Name="lblOpacity" Text="100%" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text3Brush}" MinWidth="36" TextAlignment="Right"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Click="LeaveRoom_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Source="/Icons/log-out.svg" Width="14" Height="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="방 나가기" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 제목/참여자: 버튼 뒤(마지막)에 두어 버튼이 항상 보이고, 제목은 말줄임. 제목 영역은 드래그(창 이동), 참여자 보기는 부제목 클릭. -->
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <svg:SvgViewbox x:Name="icoPinned" Source="/Icons/pin.svg" Width="13" Height="13" Margin="0,0,5,0" Visibility="Collapsed"/>
                            <svg:SvgViewbox x:Name="icoMuted" Source="/Icons/bell-off.svg" Width="13" Height="13" Margin="0,0,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtChatTitle" Text="연결 중..." FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource Text1Brush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="txtParticipants" Text="참여자 정보를 불러오고 있습니다" FontSize="12" Foreground="{DynamicResource Text3Brush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Cursor="Hand" Background="Transparent" PreviewMouseLeftButtonDown="ParticipantsBar_Down" MouseLeftButtonUp="ShowMembers_Click" ToolTip="참여자 목록 보기"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="searchPanel" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtChatSearch" Grid.Column="0" Height="32" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" Padding="12,0" VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtChatSearch_TextChanged" KeyDown="TxtChatSearch_KeyDown"/>
                    <TextBlock x:Name="txtChatSearchCount" Grid.Column="1" Text="0/0" MinWidth="42" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text3Brush}" FontSize="11" FontWeight="Bold" Margin="6,0"/>
                    <Button Grid.Column="2" Content="{StaticResource IconChevronDown}" Width="28" Height="28" Margin="0,0,4,0" Click="ChatSearchNext_Click" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource Text2Brush}" BorderThickness="0"/>
                    <Button Grid.Column="3" Content="{StaticResource IconChevronUp}" Width="28" Height="28" Click="ChatSearchPrev_Click" Background="{DynamicResource HoverBrush}" Foreground="{DynamicResource Text2Brush}" BorderThickness="0"/>
                </Grid>
            </Border>

            <ListBox Grid.Row="2" x:Name="lstChatMessages" BorderThickness="0" Background="{DynamicResource BgBrush}" Padding="18" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.ScrollChanged="ChatMessages_ScrollChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <!-- System Message Layout -->
                            <Border HorizontalAlignment="Center" Background="{DynamicResource Gray200Brush}" Padding="12,6" CornerRadius="12" MaxWidth="320" Visibility="{Binding IsSystem, Converter={StaticResource SystemMessageVisibilityConverter}}">
                                <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource Text3Brush}" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
                            </Border>

                            <!-- Normal Message Layout -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding IsMine, Converter={StaticResource MessageAlignmentConverter}}" Visibility="{Binding IsSystem, Converter={StaticResource NormalMessageVisibilityConverter}}">
                                <!-- mine: 시간/스피너가 말풍선 좌측 -->
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,6,4" Visibility="{Binding IsMine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CreatedAtLabel}" FontSize="10" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right" Visibility="{Binding TimeVisibility}"/>
                                    <!-- 둥근 회전 스피너 -->
                                    <Grid Width="14" Height="14" RenderTransformOrigin="0.5,0.5" Visibility="{Binding SpinnerVisibility}">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                        <Ellipse Stroke="{DynamicResource Gray200Brush}" StrokeThickness="2"/>
                                        <Ellipse Stroke="{DynamicResource BrandBrush}" StrokeThickness="2" StrokeDashArray="2,4"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 아바타 (incoming) -->
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrandLightBrush}" Margin="0,0,8,0" VerticalAlignment="Top" ClipToBounds="True"
                                        Visibility="{Binding IsMine, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" MouseLeftButtonUp="MessageAvatar_Click" Cursor="Hand" ToolTip="프로필 보기">
                                    <Grid>
                                        <Image local:WebImage.Url="{Binding SenderProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="16" Height="16" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <!-- 말풍선 -->
                                <Border CornerRadius="12" MaxWidth="270">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="업무전달로 저장" Click="SaveAsWorkMemo_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <!-- DynamicResource 기반으로 다크모드 전환 시 자동 반영 -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="#E0E7FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImageOnlyMessage}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource Text1Brush}" Visibility="{Binding IsMine, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Body}" FontSize="{DynamicResource MessageBodyFontSize}" TextWrapping="Wrap" LineHeight="{DynamicResource MessageBodyLineHeight}" Visibility="{Binding HasBody, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <!-- 내 말풍선(연한 mint 배경) 위 글자는 다크모드여도 항상 검정 — 가독성 보장 -->
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 첨부 업로드 진행 (용량 + 진행바) -->
                                        <StackPanel MinWidth="170" Margin="0,6,0,0" Visibility="{Binding UploadVisibility}">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="{StaticResource IconClose}" Click="CancelUpload_Click" Width="18" Height="18" FontSize="10" Padding="0" VerticalAlignment="Center" 
                                                        Background="{DynamicResource DangerLightBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding UploadInfo}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                    <Setter Property="Foreground" Value="#111827"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding UploadPercent}" Background="{DynamicResource Gray200Brush}" Foreground="{DynamicResource BrandBrush}" BorderThickness="0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,4,0,0" Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- 사진: 1장 포함 모두 1:1 cover 액자 그리드로 통일 (3장=큰1+작은2, 5장↑=2×2+N) -->
                                            <local:ChatImageGrid Images="{Binding ImageAttachments}" HorizontalAlignment="Left"
                                                                 Visibility="{Binding HasImageAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ItemsControl ItemsSource="{Binding FileAttachments}" Margin="0,6,0,0" Visibility="{Binding HasFileAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="11" CornerRadius="10" MinWidth="220" MaxWidth="280" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MouseLeftButtonUp="Attachment_Click" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource BrandLightBrush}" Margin="0,0,10,0">
                                                                    <TextBlock Text="↓" FontSize="19" FontWeight="ExtraBold" Foreground="{DynamicResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding OriginalFilename}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="190" Foreground="{DynamicResource Text1Brush}"/>
                                                                    <TextBlock Text="{Binding InfoLabel}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- not-mine: 시간이 말풍선 우측 -->
                                <StackPanel VerticalAlignment="Bottom" Margin="6,0,0,4" Visibility="{Binding IsMine, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CreatedAtLabel}" FontSize="10" Foreground="{DynamicResource Text3Brush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="pendingAttachmentsPanel" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="54" Height="54" Margin="0,0,8,0" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding PreviewPath}" Stretch="UniformToFill" Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                            <TextBlock Text="파일" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ShortName}" FontSize="9" Foreground="{DynamicResource Text3Brush}" TextTrimming="CharacterEllipsis" MaxWidth="46"/>
                                        </StackPanel>
                                        <Button Content="{StaticResource IconClose}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#CC0F172A" Foreground="White" BorderThickness="0" FontSize="12" Click="RemovePendingAttachment_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Grid.Row="1">
                        <!-- 슬림 고스트 첨부 버튼 -->
                        <Button x:Name="btnAttach" Content="+" Click="AttachMenu_Click" DockPanel.Dock="Left" Width="40" Height="54" Margin="0,0,8,0" Cursor="Hand" Background="Transparent" Foreground="{DynamicResource Text3Brush}" FontSize="24" ToolTip="첨부">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="사진" Click="AttachImage_Click"/>
                                    <MenuItem Header="동영상" Click="AttachVideo_Click"/>
                                    <MenuItem Header="첨부파일" Click="AttachFile_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ab" Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ab" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="전송" Click="SendMessage_Click" DockPanel.Dock="Right" Width="62" Height="54" Style="{StaticResource ChatButtonStyle}" Margin="10,0,0,0"/>
                        <TextBox x:Name="txtChatInput" MinHeight="54" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 Foreground="{DynamicResource Text1Brush}"
                                 CaretBrush="{DynamicResource Text1Brush}"
                                 SelectionBrush="{DynamicResource BrandBrush}"
                                 Padding="12,8" KeyDown="TxtChatInput_KeyDown" VerticalContentAlignment="Center" FontSize="14">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Invitation Modal -->
            <Grid x:Name="inviteModal" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}" Grid.RowSpan="4">
                <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Height="540" CornerRadius="24" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="대화 상대 초대" FontSize="18" FontWeight="ExtraBold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <TabControl x:Name="tabInviteSource" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource MainTabControlStyle}" Background="Transparent">
                            <TabItem Style="{StaticResource WebTabItemStyle}">
                                <TabItem.Header>
                                    <TextBlock Text="직원" Style="{StaticResource TabHeaderTextStyle}"/>
                                </TabItem.Header>
                                <Grid Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Margin="0,0,0,10" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="txtInviteSearch" Height="40" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" TextChanged="TxtInviteSearch_TextChanged"/>
                                    </Border>
                                    <ListBox Grid.Row="1" x:Name="lstInviteMembers" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" MinHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,8" Cursor="Hand" MouseLeftButtonDown="InviteRow_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,15,0" IsHitTestVisible="False"/>
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Grid>
                                                            <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="18" Height="18" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Text1Brush}"/>
                                                        <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </Grid>
                            </TabItem>
                            <TabItem Style="{StaticResource WebTabItemStyle}">
                                <TabItem.Header>
                                    <TextBlock Text="조직" Style="{StaticResource TabHeaderTextStyle}"/>
                                </TabItem.Header>
                                <TreeView x:Name="trvInviteOrg" BorderThickness="0" Background="Transparent" Padding="0,4,0,0" HorizontalContentAlignment="Stretch" MinHeight="340" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:OrgNodeModel}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Vertical">
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,2,0,4" HorizontalAlignment="Stretch" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="InviteOrgNodeToggle_Click">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding NodeType, Converter={StaticResource OrgNodeBorderConverter}}"/>
                                                        <Path Grid.Column="1" Data="{StaticResource IconGeoChevronRight}" Width="6" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="12,0,0,0" Stroke="{DynamicResource Text3Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ExpandIconConverter}}"/></Path.RenderTransform></Path>
                                                        <StackPanel Grid.Column="2" Margin="10,10,8,10" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" FontSize="14" Foreground="{DynamicResource Text1Brush}"/>
                                                            <TextBlock Text="하위 구성원을 한 번에 선택" FontSize="10" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="3" Content="선택" Click="InviteOrgNodeSelect_Click" Style="{StaticResource ChatButtonStyle}" Padding="10,5" MinWidth="52" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Members}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="6,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="4,3,4,3" Padding="10,9" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="InviteRow_Click">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                                                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="16" Height="16" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text1Brush}" FontWeight="ExtraBold" FontSize="14"/>
                                                                        <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,3,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <StackPanel HorizontalAlignment="Stretch">
                                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="14,0,0,0"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </TabItem>
                        </TabControl>
                        <Grid Grid.Row="3" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="취소" Click="CloseInvite_Click" Style="{StaticResource ChatButtonStyle}" Background="{DynamicResource Text3Brush}" Margin="0,0,5,0" Height="46"/>
                            <Button Grid.Column="1" Content="확인" Click="InviteMembers_Click" Style="{StaticResource ChatButtonStyle}" Margin="5,0,0,0" Height="46"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Participant List Modal (kept for compatibility, opens separate windows in code-behind) -->
            <Grid x:Name="membersModal" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}" Grid.RowSpan="4" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="{DynamicResource SurfaceBrush}" Width="320" Height="400" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="대화 참여자" FontSize="18" FontWeight="ExtraBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <ListBox Grid.Row="1" x:Name="lstMembers" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                             <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="MemberRow_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                <Grid>
                                                    <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="16" Height="16" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <Border Width="9" Height="9" CornerRadius="4.5" DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                                                    Background="{Binding ActualStatusClass, Converter={StaticResource StatusColorConverter}}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Text1Brush}"/>
                                                    <TextBlock Text="{Binding JobTitle}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Content="닫기" Click="CloseMembers_Click" Style="{StaticResource ChatButtonStyle}" Background="{DynamicResource Text3Brush}" Margin="0,15,0,0" Height="40"/>
                    </Grid>
                </Border>

                <!-- Detail Side Panel (right of the participants card) -->
                <Border x:Name="memberDetailPanel" Visibility="Collapsed" Margin="14,0,0,0" Background="{DynamicResource SurfaceBrush}" Width="320" Height="400" CornerRadius="16" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="참여자 정보" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="{StaticResource IconClose}" Click="CloseMemberDetail_Click" Width="26" Height="26" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Padding="0" FontSize="14"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource BrandLightBrush}" CornerRadius="40" Width="80" Height="80" Margin="0,4,0,12" ClipToBounds="True" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenMemberImage_Click" ToolTip="크게 보기">
                                    <Grid>
                                        <Image x:Name="imgMemberDetail" Stretch="UniformToFill"/>
                                        <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="36" Height="36" Visibility="{Binding Source={x:Reference imgMemberDetail}, Path=Source, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="txtMemberName" Text="이름" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{DynamicResource Text1Brush}"/>
                                <TextBlock x:Name="txtMemberDept" Text="본부 · 팀" FontSize="12" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="직급" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMemberJob" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="내선번호" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtMemberExt" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="휴대폰" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtMemberMobile" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="이메일" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMemberEmail" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>
            <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Margin="0,0,5,5"/>
        </Grid>
    </Border>
</Window>
