<Window x:Class="Portfolio.OfficeSystem.TextInputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입력"
        Width="420" Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="frame" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="28"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="txtTitle" Text="입력" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock x:Name="txtMessage" Text="값을 입력하세요." FontSize="13" Foreground="{DynamicResource Text2Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="20"/>
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,24">
                <TextBox x:Name="txtInput" Height="48" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center" Foreground="{DynamicResource Text1Brush}" CaretBrush="{DynamicResource Text1Brush}" SelectionBrush="{DynamicResource BrandBrush}"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="취소" Click="Cancel_Click" Style="{StaticResource DialogButtonStyle}" Background="{DynamicResource Text3Brush}" Height="46" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="저장" Click="Save_Click" Style="{StaticResource DialogButtonStyle}" Background="{DynamicResource BrandBrush}" Height="46" Margin="6,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
