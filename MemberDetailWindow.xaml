<Window x:Class="Portfolio.OfficeSystem.MemberDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        Title="참여자 정보" Width="280" Height="460"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/App.ico"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Direction="270"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseDown" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text3Brush}" Cursor="Hand" Padding="0" FontSize="14"/>
                <TextBlock x:Name="txtHeader" Text="참여자 정보" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{DynamicResource BrandLightBrush}" CornerRadius="40" Width="80" Height="80" Margin="0,6,0,12" ClipToBounds="True" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OpenImage_Click" ToolTip="크게 보기">
                        <Grid>
                            <Image x:Name="imgMember" Stretch="UniformToFill"/>
                            <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="36" Height="36" Visibility="{Binding Source={x:Reference imgMember}, Path=Source, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="txtName" Text="이름" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{DynamicResource Text1Brush}"/>
                    <TextBlock x:Name="txtDept" Text="본부 · 팀" FontSize="12" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="직급" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtJob" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="내선번호" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtExt" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="휴대폰" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtMobile" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="이메일" Foreground="{DynamicResource Text3Brush}" Margin="0,5" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtEmail" Text="-" FontWeight="Bold" Margin="0,5" FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="btnDirectChat" Grid.Row="2" Content="1:1 대화" Click="DirectChat_Click" Height="40" Margin="0,14,0,0"
                    Background="{DynamicResource BrandBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
