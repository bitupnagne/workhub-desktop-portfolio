                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,15,0" IsHitTestVisible="False"/>
                                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="18" Height="18" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Text1Brush}"/>
                                                                <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Style="{StaticResource WebTabItemStyle}">
                                    <TabItem.Header>
                                        <TextBlock Text="조직" Style="{StaticResource TabHeaderTextStyle}"/>
                                    </TabItem.Header>
                                    <TreeView x:Name="trvInviteOrg" BorderThickness="0" Background="Transparent" Padding="0,4,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate DataType="{x:Type local:OrgNodeModel}" ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Vertical">
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,2,0,4" HorizontalAlignment="Stretch" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="InviteOrgNodeToggle_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding NodeType, Converter={StaticResource OrgNodeBorderConverter}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding IsExpanded, Converter={StaticResource ExpandIconConverter}}" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Text3Brush}"/>
                                                            <StackPanel Grid.Column="2" Margin="10,10,8,10" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" FontSize="14" Foreground="{DynamicResource Text1Brush}"/>
                                                                <TextBlock Text="선택한 조직과 하위 조직 구성원을 포함합니다" FontSize="10" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="선택" Click="InviteOrgNodeSelect_Click" Style="{StaticResource WebButtonStyle}" Padding="10,5" MinWidth="52" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Members}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="6,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="4,3,4,3" Padding="10,9" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="InviteRow_Click">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                                                                </DataTrigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                                                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrandLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image local:WebImage.Url="{Binding ProfileImageUrl}" Stretch="UniformToFill" Visibility="{Binding HasProfileImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="16" Height="16" Visibility="{Binding HasProfileImage, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text1Brush}" FontWeight="ExtraBold" FontSize="14"/>
                                                                            <TextBlock Text="{Binding TeamName}" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,3,0,0"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TreeViewItem">
                                                            <StackPanel HorizontalAlignment="Stretch">
                                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                                <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="14,0,0,0"/>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsExpanded" Value="True">
                                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </TabItem>
                            </TabControl>
                            <Grid Grid.Row="3" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="취소" Click="CloseInvite_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource Text3Brush}" Margin="0,0,5,0" Height="46"/>
                                <Button Grid.Column="1" Content="확인" Click="CreateChatFromInvite_Click" Style="{StaticResource WebButtonStyle}" Margin="5,0,0,0" Height="46"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="employeeDetailModal" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                    <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" CornerRadius="24" Padding="30">
                        <StackPanel>
                            <TextBlock Text="직원 정보" FontSize="18" FontWeight="ExtraBold" Margin="0,0,0,25" HorizontalAlignment="Center"/>
                            <Border Background="{DynamicResource BrandLightBrush}" CornerRadius="45" Width="90" Height="90" Margin="0,0,0,20" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="OpenEmpImage_Click" ToolTip="사진 보기">
                                <Grid>
                                    <Image x:Name="imgEmpDetail" Stretch="UniformToFill"/>
                                    <svg:SvgViewbox Source="/Icons/user-brand.svg" Width="42" Height="42" Visibility="{Binding Source={x:Reference imgEmpDetail}, Path=Source, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="txtEmpName" Text="이름" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtEmpDept" Text="부서" FontSize="14" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,6,0,25"/>
                            <Grid Margin="0,0,0,30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="직급" Foreground="{DynamicResource Text3Brush}" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtEmpJob" Text="-" FontWeight="Bold" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="내선번호" Foreground="{DynamicResource Text3Brush}" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtEmpExt" Text="-" FontWeight="Bold" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="휴대폰" Foreground="{DynamicResource Text3Brush}" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtEmpMobile" Text="-" FontWeight="Bold" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="이메일" Foreground="{DynamicResource Text3Brush}" Margin="0,7" FontSize="14"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtEmpEmail" Text="-" FontWeight="Bold" Margin="0,7" FontSize="14" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="1:1 채팅" Click="EmpChat_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource BrandBrush}" Margin="0,0,5,0" Height="46"/>
                                <Button Grid.Column="1" Content="닫기" Click="CloseEmpDetail_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource Text3Brush}" Margin="5,0,0,0" Height="46"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="customModal" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                    <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" CornerRadius="20" Padding="30">
                        <StackPanel>
                            <TextBlock x:Name="txtModalTitle" Text="확인" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock x:Name="txtModalBody" Text="정말 처리하시겠습니까?" FontSize="14" Foreground="{DynamicResource Text2Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="20"/>
                            <Grid x:Name="gridModalButtons">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnModalNo" Grid.Column="0" Content="취소" Click="ModalNo_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource Text3Brush}" Margin="0,0,5,0" Height="42"/>
                                <Button x:Name="btnModalYes" Grid.Column="1" Content="확인" Click="ModalYes_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource BrandBrush}" Margin="5,0,0,0" Height="42"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2차 인증(OTP) 모달 — 로그인 후 OTP 필수 계정에 표시(닫기 불가, 검증/등록) -->
                <Grid x:Name="otpModal" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
                    <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" CornerRadius="20" Padding="26">
                        <StackPanel>
                            <TextBlock Text="2차 인증(OTP)" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtOtpMsg" Text="" FontSize="13" Foreground="{DynamicResource Text2Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="19"/>
                            <Border x:Name="otpQrBox" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Image x:Name="imgOtpQr" Width="180" Height="180"/>
                            </Border>
                            <TextBlock x:Name="txtOtpKey" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="※ 서버 시간과 휴대폰 시간이 일치해야 합니다." FontSize="11" Foreground="#B7791F" TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="인증 앱이 없으면: 스토어에서 'Google Authenticator' 또는 'Microsoft Authenticator' 검색·설치" FontSize="11" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <!-- [1.0.22] 6자리 분리 입력 — 자동 포커스 이동·붙여넣기 분배·완성 시 자동 검증 -->
                            <!-- [1.0.27] 6칸 수렴 + 로딩 스피너(최소 1.5초) + 성공/실패 애니메이션 -->
                            <Grid Margin="0,2,0,4" Height="52">
                                <StackPanel x:Name="otpBoxesPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="otpBoxesScale" ScaleX="1"/>
                                    </StackPanel.RenderTransform>
                                    <TextBox x:Name="otpBox1" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                    <TextBox x:Name="otpBox2" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                    <TextBox x:Name="otpBox3" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                    <TextBox x:Name="otpBox4" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                    <TextBox x:Name="otpBox5" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                    <TextBox x:Name="otpBox6" Width="40" Height="50" MaxLength="1" FontSize="20" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" TextChanged="OtpBox_TextChanged" PreviewKeyDown="OtpBox_PreviewKeyDown"/>
                                </StackPanel>
                                <Grid x:Name="otpAnimChip" Visibility="Collapsed" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid x:Name="otpSpinner">
                                        <Ellipse Stroke="#E5E8EF" StrokeThickness="3"/>
                                        <Path Stroke="{DynamicResource BrandBrush}" StrokeThickness="3" StrokeStartLineCap="Round" Data="M 15,2 A 13,13 0 0 1 28,15" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="otpSpinRot" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <Path x:Name="otpCheck" Visibility="Collapsed" Stroke="#10B981" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 6,15.5 L 12.5,22 L 24,7"/>
                                    <Path x:Name="otpCross" Visibility="Collapsed" Stroke="#EF4444" StrokeThickness="3" StrokeStartLineCap="Round" Data="M 8,8 L 22,22 M 22,8 L 8,22"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="txtOtpResult" Visibility="Collapsed" Text="" FontSize="16" FontWeight="ExtraBold" TextAlignment="Center" Margin="0,8,0,2"/>
                            <TextBlock x:Name="txtOtpBusy" Visibility="Collapsed" Text="검증 중…" FontSize="12" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center" Margin="0,2,0,2"/>
                            <TextBlock x:Name="txtOtpErr" Visibility="Collapsed" Text="" FontSize="12" Foreground="#D33" TextAlignment="Center" Margin="0,2,0,4"/>
                            <Button Content="로그아웃" Click="OtpLogout_Click" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource Text3Brush}" Height="36" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
