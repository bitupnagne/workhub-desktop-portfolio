<Window x:Class="Portfolio.OfficeSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="WorkHub Desktop" Height="700" Width="460" MinHeight="620" MinWidth="420"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/App.ico"
        FontFamily="{DynamicResource BaseFontFamily}"
        Foreground="{DynamicResource Text1Brush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Background="#999999" CornerRadius="5" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#666666"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <local:StatusColorConverter x:Key="StatusColorConverter"/>
        <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <local:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <local:MessageForegroundConverter x:Key="MessageForegroundConverter"/>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <local:ExpandIconConverter x:Key="ExpandIconConverter"/>
        <local:OrgNodeBackgroundConverter x:Key="OrgNodeBackgroundConverter"/>
        <local:OrgNodeBorderConverter x:Key="OrgNodeBorderConverter"/>
        <local:OrgNodeLabelConverter x:Key="OrgNodeLabelConverter"/>
        <local:HexBrushConverter x:Key="HexBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="TitleIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleIconButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBg" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBg" Property="Background" Value="{DynamicResource DangerLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBg" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InviteRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ?熬곥굤????(?꾩룇猷????곌랜?亦??繞벿살탳????? ????戮?뎽 ????곗뒧????꾩룄?쀧몭?-->
        <Style x:Key="WebFilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WebButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============== Context Menu / Menu Item ============== -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.18" Direction="270"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="brd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Path Grid.Column="1" x:Name="chk" Width="12" Height="12" Stretch="Uniform" Margin="10,0,0,0"
                                      Fill="{DynamicResource BrandDarkBrush}" Visibility="Collapsed"
                                      Data="M3,7 L6,10 L11,3"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="brd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="4,5" Opacity="0.7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ?????類ㅻ틡 TabItem.Header ???깅꺄 ??怨뚮낵 ??TextElement.Foreground ??⑤챶爰???異???琉돠??? ??袁ぢ?             嶺뚮ㅏ援???Foreground + IsSelected DataTrigger ?????꾩씩嶺뚮ㅄ維獄???ルㅎ臾???源녿굵 嶺뚮ㅄ維筌??筌먐쇰꼪???곌랜??? -->
        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WebTabItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="container" Background="Transparent" Margin="0,0,1,0">
                            <Border x:Name="border" Padding="0,14" BorderThickness="0,0,0,4" BorderBrush="Transparent"
                                    TextElement.Foreground="{DynamicResource Text3Brush}"
                                    TextElement.FontWeight="Bold"
                                    TextElement.FontSize="14">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="container" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource Text1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="{DynamicResource SurfaceBrush}"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ?????類ㅻ틡 ?筌먐븍Ф TabControl: ??レ뒩???筌뤾퍔夷??????類ㅻ틡(72px) + ??⑥? ???쳜???럹? 嶺뚮∥????怨뺣뼺? ???? ?筌먲퐢沅?? -->
        <Style x:Key="SidebarTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ?????類ㅻ틡??TabItem: ?熬곣뫗逾????+ 嶺뚯쉧猷? ??怨뚮낵 ?熬곣뫁?? ??ルㅎ臾?????レ뒩??3px ??곗뒧????筌뤾퍓???댟??袁㏃댉 + ??? ??곗뒧????꾩룄?쀧몭? -->
        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="container" Background="Transparent">
                            <Border x:Name="indicator" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                            <Border x:Name="border" Padding="0,12" BorderThickness="0"
                                    TextElement.Foreground="{DynamicResource Text1Brush}"
                                    TextElement.FontWeight="Bold"
                                    TextElement.FontSize="11">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="container" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource Text1Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="indicator" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="container" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{DynamicResource BrandDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding InMonth}" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrandDarkBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="12,10" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="headerFrame" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"/>
                                                    <svg:SvgViewbox Grid.Column="1" x:Name="chevron" Source="/Icons/chevron-down.svg" Width="14" Height="14" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                        <svg:SvgViewbox.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </svg:SvgViewbox.RenderTransform>
                                                    </svg:SvgViewbox>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="headerFrame" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="headerFrame" Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.14"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Opacity="0" Margin="12,0,12,12">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform Y="-6"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-6" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/> 
                <RowDefinition Height="*"/>  
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="titleBar" CornerRadius="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                <DockPanel LastChildFill="False" Margin="14,0,10,0">
                    <svg:SvgViewbox x:Name="HeaderAppLogo" Source="/AppLogo.svg" Width="152" Height="38" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center" ToolTip="WorkHub Desktop" AutomationProperties.Name="WorkHub"/>
                    <Button Click="CloseButton_Click" DockPanel.Dock="Right" Style="{StaticResource TitleCloseButtonStyle}">
                        <svg:SvgViewbox Source="/Icons/x.svg" Width="16" Height="16"/>
                    </Button>
                    <Button Click="Minimize_Click" DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource TitleIconButtonStyle}">
                        <svg:SvgViewbox Source="/Icons/minus.svg" Width="16" Height="16"/>
                    </Button>
                    <Button x:Name="btnOpenWeb" Click="OpenFullSystem_Click" DockPanel.Dock="Right" Height="30" Margin="0,0,8,0" Padding="10,0" Background="{DynamicResource BrandBrush}" BorderThickness="0" Cursor="Hand" ToolTip="웹 시스템 열기">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="wb" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <svg:SvgViewbox Source="/Icons/globe-white.svg" Width="13" Height="13" Margin="0,0,5,0"/>
                                        <TextBlock Text="웹 이동" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="wb" Property="Background" Value="{DynamicResource BrandDarkBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnNotificationsBell" Click="ToggleNotificationsPopup_Click" DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource TitleIconButtonStyle}" ToolTip="알림">
                        <Grid Width="22" Height="22">
                            <svg:SvgViewbox x:Name="headerIconBell" Source="/Icons/bell.svg" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="badgeNotifications" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Padding="4,1" CornerRadius="8" Background="{DynamicResource DangerBrush}" MinWidth="14" Height="13" Visibility="Collapsed">
                                <TextBlock x:Name="txtNotificationsBadge" Text="0" Foreground="White" FontSize="8" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="btnSettings" Click="Settings_Click" DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource TitleIconButtonStyle}">
                        <svg:SvgViewbox Source="/Icons/settings.svg" Width="16" Height="16"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuTheme" Click="ToggleTheme_Click" IsCheckable="True">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Source="/Icons/moon.svg" Width="14" Height="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="다크 모드" VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="OpenServerConfig_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Source="/Icons/settings.svg" Width="14" Height="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="서버 주소 설정" VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="menuLogout" Click="Logout_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource DangerBrush}" Margin="2,0,11,0" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                                </Border.Effect>
                                            </Border>
                                            <TextBlock Text="로그아웃" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="ExitApp_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgViewbox Source="/Icons/power.svg" Width="14" Height="14" Margin="0,0,10,0"/>
                                            <TextBlock Text="앱 종료" VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem></ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>
                <Popup x:Name="popupNotifications"
                       PlacementTarget="{Binding ElementName=btnNotificationsBell}"
                       Placement="Bottom" HorizontalOffset="0" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" MinWidth="380" MaxHeight="600" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.22" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="14,12,10,6">
                                <!-- [W9] 모두 읽음 — 웹과 동일 기능 -->
                                <Button x:Name="btnNotifReadAll" DockPanel.Dock="Right" Click="NotifReadAll_Click"
                                        Style="{StaticResource WebFilterChipStyle}" VerticalAlignment="Center">
                                    <TextBlock Text="모두 읽음"/>
                                </Button>
                                <TextBlock Text="알림" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,8">
                                <Button x:Name="btnNotifFilterNew" Tag="unread" Click="NotifFilter_Click" Style="{StaticResource WebFilterChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="새 알림"/>
                                        <TextBlock x:Name="txtNotifNewCount" Text=" 0" Margin="2,0,0,0" FontWeight="Black"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnNotifFilterRead" Tag="read" Click="NotifFilter_Click" Margin="6,0,0,0" Style="{StaticResource WebFilterChipStyle}">
                                    <TextBlock Text="읽음"/>
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="2" Background="{DynamicResource BgBrush}" MinHeight="420">
                                <Grid x:Name="emptyNotifications" Visibility="Collapsed" IsHitTestVisible="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Gray100Brush}" HorizontalAlignment="Center">
                                            <svg:SvgViewbox x:Name="emptyIconBellOff" Source="/Icons/bell-off.svg" Width="24" Height="24"/>
                                        </Border>
                            <TextBlock x:Name="txtEmptyNotifications" Text="알림이 없습니다" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="lstNotifications" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Padding="12"
                                         ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:NotificationGroup}">
                                            <StackPanel Margin="0,0,0,8">
                                                <Border Visibility="{Binding SectionVisibility}" Background="{DynamicResource Gray100Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,2,0,8">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding SectionTitle}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource BrandDarkBrush}" VerticalAlignment="Center"/>
                                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                                <Border MinHeight="76" Padding="14,12" MouseLeftButtonUp="NotificationGroupHeader_Click">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource HoverItemStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Head.IsUnread}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrandLightBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Border Visibility="{Binding Head.IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,0,5">
                                                                <TextBlock Text="NEW" Foreground="White" FontSize="9" FontWeight="Black"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Head.Title}" Foreground="{DynamicResource Text1Brush}" FontWeight="ExtraBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Head.PlainBody}" Foreground="{DynamicResource Text2Brush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                                            <DockPanel Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding Head.SenderName}" FontSize="11" Foreground="{DynamicResource BrandDarkBrush}" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Head.CreatedAtLabel}" FontSize="10" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                            <Border Visibility="{Binding GroupBadgeVisibility}" Background="{DynamicResource BrandLightBrush}" CornerRadius="9" Padding="7,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountLabel}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrandDarkBrush}"/>
                                                            </Border>
                                        <Button Background="Transparent" BorderThickness="0" Margin="2,-4,-4,0" Padding="6" Click="DeleteNotificationGroup_Click" Cursor="Hand" ToolTip="삭제">
                                                                <svg:SvgViewbox Source="/Icons/x.svg" Width="13" Height="13"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- [W9] 알림 작업 로딩 — 메인 오버레이 대신 알림 창 안에서 표시 -->
                                <Grid x:Name="notifBusyOverlay" Visibility="Collapsed" Background="#B3FFFFFF" Panel.ZIndex="9">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ProgressBar x:Name="prgNotifBusy" Width="200" Height="6" IsIndeterminate="True"
                                                     Foreground="{DynamicResource BrandBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="0"/>
                                        <TextBlock x:Name="txtNotifBusy" Text="처리 중..." Margin="0,10,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text2Brush}" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <tb:TaskbarIcon x:Name="trayIcon" ToolTipText="WorkHub Desktop" TrayMouseDoubleClick="TrayIcon_DoubleClick">
                    <tb:TaskbarIcon.ContextMenu>
                        <ContextMenu Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource Text1Brush}"
                                     BorderBrush="{DynamicResource BorderBrush}">
                            <MenuItem Header="WorkHub Desktop" IsEnabled="False" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}"/>
                            <Separator/>
                            <MenuItem Header="열기" Click="OpenApp_Click" Foreground="{DynamicResource Text1Brush}"/>
                            <Separator/>
                            <MenuItem Click="Logout_Click" Header="로그아웃" Foreground="{DynamicResource DangerBrush}"/>
                            <MenuItem Header="앱 종료" Click="ExitApp_Click" Foreground="{DynamicResource Text1Brush}"/>
                        </ContextMenu>
                    </tb:TaskbarIcon.ContextMenu>
                </tb:TaskbarIcon>

                <!-- Initial Loading View -->
                <Grid x:Name="initialLoadingView" Visibility="Visible" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <svg:SvgViewbox x:Name="LoadingAppLogo" Source="/AppLogo.svg" Width="280" Height="70" Margin="0,0,0,30" AutomationProperties.Name="WorkHub"/>
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{DynamicResource BrandBrush}" Background="{DynamicResource HoverBrush}" BorderThickness="0"/>
                        <TextBlock Text="시스템을 준비하고 있습니다..." Margin="0,15,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Text3Brush}" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Login View -->
                <Grid x:Name="loginView" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                    <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,25" CornerRadius="24" Width="400" Margin="0,-20,0,0">
                        <StackPanel>
                        <svg:SvgViewbox x:Name="LoginAppLogo" Source="/AppLogo.svg" Width="288" Height="72" HorizontalAlignment="Center" Margin="0,12,0,28" AutomationProperties.Name="WorkHub"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,12">
                                <Grid>
                                    <TextBox x:Name="txtUsername" Height="44" BorderThickness="0" Background="Transparent" Padding="15,0" VerticalContentAlignment="Center" FontSize="14" Foreground="{DynamicResource Text1Brush}" CaretBrush="{DynamicResource Text1Brush}"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Margin="0,0,0,10">
                                <Grid>
                                    <PasswordBox x:Name="txtPassword" Height="44" BorderThickness="0" Background="Transparent" Padding="15,0" VerticalContentAlignment="Center" KeyDown="TxtPassword_KeyDown" PasswordChanged="TxtPassword_PasswordChanged" FontSize="14" Foreground="{DynamicResource Text1Brush}" CaretBrush="{DynamicResource Text1Brush}"/>
                                    <TextBlock x:Name="txtPasswordPlaceholder" Text="Password" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="15,0" IsHitTestVisible="False" FontSize="14"/>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="chkRememberLogin" Content="로그인 유지" IsChecked="True" Margin="2,0,0,15" Foreground="{DynamicResource Text2Brush}" FontWeight="SemiBold" FontSize="13"/>
                            <Button Content="로그인" Click="Login_Click" Height="48" Style="{StaticResource WebButtonStyle}" FontSize="15"/>
                            <TextBlock x:Name="txtLoginError" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main View -->
                <Grid x:Name="mainView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="*"/>    
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgBrush}" Padding="18,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="myProfilePhotoButton" Grid.Row="0" Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BrandLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,12,0" Cursor="Hand" ToolTip="프로필 사진 보기" MouseLeftButtonUp="MyProfilePhoto_Click">
                                <Grid>
                                    <Image x:Name="imgUserProfile" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtUserName" Text="사용자" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}"/>
                                <TextBlock x:Name="txtUserDept" Text="부서 · 팀" FontSize="12" Foreground="{DynamicResource Text3Brush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="txtCurrentTime" Text="14:00:00" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" FontSize="18" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="txtTodayDate" Text="2026.05.21" Foreground="{DynamicResource Text3Brush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="statusBadge" Margin="0,14,0,0" Padding="10,5" CornerRadius="10" Background="{DynamicResource BrandLightBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtAttendanceStatus" Text="근무중 · 0시간 0분" FontSize="11" Foreground="{DynamicResource BrandDarkBrush}" FontWeight="ExtraBold"/>
                            </Border>

                            <StackPanel x:Name="attendanceButtonPanel" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="btnCheckIn" Content="출근" Click="CheckIn_Click" Width="64" Height="36" Margin="0,0,6,0" Style="{StaticResource WebButtonStyle}"/>
                                <Button x:Name="btnCheckOut" Content="퇴근" Click="CheckOut_Click" Width="64" Height="36" Style="{StaticResource WebButtonStyle}" Background="{DynamicResource Gray600Brush}"/>
                            </StackPanel>
                            <Border x:Name="attendanceDonePanel" Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" Padding="12,8" CornerRadius="12" Background="{DynamicResource BrandLightBrush}" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock Text="오늘 근무 시간" FontSize="12" FontWeight="Black" Foreground="{DynamicResource BrandDarkBrush}"/>
                            </Border>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="chipCheckIn" Visibility="Collapsed" Background="{DynamicResource Gray100Brush}" CornerRadius="8" Padding="9,5" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                <TextBlock Text="출근 시간" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtCheckInTime" Text="--:--" FontSize="12" Foreground="{DynamicResource Text1Brush}" FontWeight="ExtraBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="chipCheckOut" Visibility="Collapsed" Background="{DynamicResource Gray100Brush}" CornerRadius="8" Padding="9,5">
                                    <StackPanel Orientation="Horizontal">
                                <TextBlock Text="퇴근 시간" FontSize="11" Foreground="{DynamicResource Text3Brush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtCheckOutTime" Text="--:--" FontSize="12" Foreground="{DynamicResource Text1Brush}" FontWeight="ExtraBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" Style="{StaticResource SidebarTabControlStyle}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}">
                        <!-- [???逾? 1.0.74 ???????類ㅻ틡 ????????녹맠 ??Popup??怨쀬Ŧ ?????#63 ?熬곣뫁??. -->
                        <TabItem Style="{StaticResource SidebarTabItemStyle}">
                            <TabItem.Header>
                                <StackPanel HorizontalAlignment="Center" ToolTip="일정">
                                    <svg:SvgViewbox x:Name="sideIconCalendar" Source="/Icons/calendar.svg" Width="22" Height="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="일정" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer Background="{DynamicResource BgBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="16,14,16,8" Padding="14,12" CornerRadius="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Width="32" Height="32" Margin="0,0,6,0" Click="CalendarPrevMonth_Click" Background="{DynamicResource Gray100Brush}" BorderThickness="0" Cursor="Hand" ToolTip="이전 달">
                                                <TextBlock Text="‹" FontSize="20" FontWeight="Black" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Width="44" Height="32" Margin="0,0,6,0" Click="CalendarToday_Click" Background="{DynamicResource BrandLightBrush}" BorderThickness="0" Cursor="Hand" ToolTip="오늘">
                                                <TextBlock Text="오늘" FontSize="11" FontWeight="Black" Foreground="{DynamicResource BrandDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Width="32" Height="32" Click="CalendarNextMonth_Click" Background="{DynamicResource Gray100Brush}" BorderThickness="0" Cursor="Hand" ToolTip="다음 달">
                                                <TextBlock Text="›" FontSize="20" FontWeight="Black" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Company Calendar" FontSize="10" FontWeight="Black" Foreground="{DynamicResource BrandDarkBrush}"/>
                                        <TextBlock x:Name="txtCalendarMonth" Text="2026년 5월" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Row="1" Margin="16,0,16,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,6">
                                        <TextBlock Text="월" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="화" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="수" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="목" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="금" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="토" FontSize="11" FontWeight="Black" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="일" FontSize="11" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                    </UniformGrid>
                                    <ItemsControl Grid.Row="1" x:Name="lstCalendarDays">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:CalendarDayModel}">
                                                <Button Style="{StaticResource CalendarDayButtonStyle}" Height="38" Margin="2" Click="CalendarDay_Click">
                                                    <Grid>
                                                        <TextBlock Text="{Binding DayText}" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource Text1Brush}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                                        <ItemsControl ItemsSource="{Binding ScheduleDotBrushes}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="{Binding HasSchedules, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding ScheduleCountToolTip}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
