<Window x:Class="Portfolio.OfficeSystem.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Portfolio.OfficeSystem"
        Title="이미지 보기"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True">
    <!-- 웹 file-viewer 모달과 동일한 중앙 다이얼로그 카드 (전체화면 X) -->
    <Border CornerRadius="12" Background="#0F172A" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 헤더: 제목 + 닫기 -->
            <Border Grid.Row="0" Background="White" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <TextBlock x:Name="txtTitle" Text="이미지 보기" VerticalAlignment="Center" Margin="16,0,44,0" FontSize="14" FontWeight="Bold" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Width="30" Height="30" CornerRadius="8" Background="#F3F4F6" Cursor="Hand" MouseLeftButtonDown="Close_MouseUp">
                        <Path Data="{StaticResource IconGeoClose}" Width="13" Height="13" Stretch="Uniform" Stroke="#6B7280" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <!-- 이미지 영역 (다크 배경은 바깥 Border 색이 비쳐 둥근 하단 유지) -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Image x:Name="imgPreview" Stretch="Uniform" Margin="18" RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                       MouseWheel="Image_MouseWheel" MouseLeftButtonDown="Image_MouseDown" MouseMove="Image_MouseMove" MouseLeftButtonUp="Image_MouseUp">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="imgScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="imgTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="btnPrev" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Background="#30FFFFFF" CornerRadius="14" Width="42" Height="58" Cursor="Hand" MouseLeftButtonUp="Prev_MouseUp" Visibility="Collapsed">
                    <TextBlock Text="‹" Foreground="White" FontSize="38" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                </Border>
                <Border x:Name="btnNext" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Background="#30FFFFFF" CornerRadius="14" Width="42" Height="58" Cursor="Hand" MouseLeftButtonUp="Next_MouseUp" Visibility="Collapsed">
                    <TextBlock Text="›" Foreground="White" FontSize="38" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                </Border>
            </Grid>
            <!-- 다중 이미지 하단 썸네일 스트립 (이미지를 가리지 않는 별도 영역) -->
            <Border x:Name="thumbStrip" Grid.Row="2" Background="#0B1220" CornerRadius="0,0,12,12" Padding="10,8" Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                    <ItemsControl x:Name="thumbList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="62" Height="46" Margin="3,0" CornerRadius="6" ClipToBounds="True" BorderThickness="2" Background="#1E293B" Cursor="Hand" MouseLeftButtonUp="Thumb_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4F46E5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image local:WebImage.Url="{Binding Url}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
